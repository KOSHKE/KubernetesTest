# Payment Service Configuration
# Copy this file to payment-service.env and adjust values

# Service Ports
PAYMENT_SERVICE_PORT=50054
PAYMENT_SERVICE_METRICS_PORT=9097

# Payment Processing
PAYMENT_PROCESS_TIMEOUT=30s
KAFKA_PUBLISH_TIMEOUT=10s
PAYMENT_MAX_RETRIES=3
PAYMENT_RETRY_DELAY=1s
PAYMENT_DEFAULT_CURRENCY=USD
PAYMENT_SUPPORTED_METHODS=CREDIT_CARD,DEBIT_CARD,BANK_TRANSFER
ORDER_TOTAL_TTL=30m
