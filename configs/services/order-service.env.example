# Order Service Configuration
# Copy this file to order-service.env and adjust values

# Service Ports

# Order Processing
ORDER_DEFAULT_CURRENCY=USD
ORDER_MAX_ITEMS=100
ORDER_MAX_VALUE=1000000
INVENTORY_PROVIDER_TIMEOUT=3s
ORDER_ITEM_MAX_QUANTITY=1000
ORDER_ITEM_MIN_QUANTITY=1
ORDER_ITEM_MAX_PRICE=100000
ORDER_SUPPORTED_CURRENCIES=USD,EUR,GBP,RUB
ORDER_GRACEFUL_SHUTDOWN_TIMEOUT=30s

# Service Dependencies
INVENTORY_SERVICE_URL=inventory-service:50053
