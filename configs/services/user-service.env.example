# User Service Configuration
# Copy this file to user-service.env and adjust values

# Service Ports
USER_SERVICE_METRICS_PORT=9091

# User Service Specific
STORAGE_URL=redis:6379
STORAGE_TIMEOUT=5s
USER_MAX_PASSWORD_LENGTH=128
USER_MIN_PASSWORD_LENGTH=8
USER_MAX_NAME_LENGTH=50
USER_MAX_PHONE_LENGTH=50
USER_MAX_EMAIL_LENGTH=255

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production-2025
JWT_ACCESS_SECRET=your-super-secret-jwt-key-change-in-production-2025
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production-2025
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
