# Kafka Configuration
# Copy this file to kafka.env and adjust values

# Kafka Brokers
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Kafka Client Configuration
KAFKA_CLIENT_ID=inventory-service
KAFKA_GROUP_ID=inventory-service
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_SESSION_TIMEOUT=30s
KAFKA_HEARTBEAT_INTERVAL=3s
KAFKA_MAX_POLL_RECORDS=500
KAFKA_MAX_POLL_INTERVAL=300s

# Kafka Producer Configuration
KAFKA_PRODUCER_ACKS=all
KAFKA_PRODUCER_DELIVERY_TIMEOUT=30s
KAFKA_PRODUCER_FLUSH_TIMEOUT=5s
